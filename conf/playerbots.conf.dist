[playerbots]

# Optional mod-playerbots configuration. These values override legacy options
# in worldserver.conf. Missing files retain legacy settings and compiled defaults.

#
#    Playerbots.Dev.Enabled
#        Description: Enables the isolated server-origin development bots.
#                     All configured bot accounts are reserved from human-client login while enabled.
#                     This is a manual development control, not a bot population system.
#        Default:     0 - (Disabled)
#                     1 - (Enabled)

Playerbots.Dev.Enabled = 0

#
#    Playerbots.Dev.GreetingOnJoin
#        Description: Have an admitted Playerbot whisper a short greeting when
#                     it accepts an eligible human player's party invitation.
#        Default:     1 - (Enabled while Playerbots.Dev.Enabled is on)

Playerbots.Dev.GreetingOnJoin = 1

#
#    Playerbots.Dev.EngineWarriorBuff
#        Description: Experimental Warrior out-of-combat Battle Shout path via
#                     the imported Playerbots engine. Replaces only the existing
#                     Battle Shout maintenance call; does not enable combat AI.
#                     Requires a server restart to compare paths reliably.
#        Default:     0 - (Existing companion buff behavior)

Playerbots.Dev.EngineWarriorBuff = 0

#
#    Playerbots.Dev.EngineWarriorCombat
#        Description: Experimental Warrior combat route through the imported
#                     Playerbots engine. Protection talents use a bounded tank
#                     strategy with party-target Taunt; other or unset trees
#                     use a generic low-level melee fallback. Replaces only
#                     the existing Warrior spell priority. Restart to compare.
#        Default:     0 - (Existing companion Warrior behavior)

Playerbots.Dev.EngineWarriorCombat = 0

#
#    Playerbots.Dev.EngineMageCombat
#        Description: Experimental Mage combat route through the imported
#                     Playerbots engine. Frost talents use the bounded Frost
#                     strategy; other or unset trees use the generic fallback.
#                     This replaces only the existing Mage spell priority.
#                     Restart to compare paths reliably.
#        Default:     0 - (Existing companion Mage behavior)

Playerbots.Dev.EngineMageCombat = 0

#
#    Playerbots.Dev.EnginePriestHeal
#        Description: Experimental Priest party-healing route through the
#                     imported Playerbots engine. Uses the Cata-validated
#                     Shield, Flash Heal, Heal and Renew spell set. Also enables
#                     out-of-combat Priest Resurrection for nearby dead party
#                     members and party-bot acceptance of resurrection offers.
#                     Does not enable a complete talent rotation.
#                     Restart to compare paths reliably.
#        Default:     0 - (Existing companion Priest healing)

Playerbots.Dev.EnginePriestHeal = 0

#
#    Playerbots.Dev.AccountId
#        Description: Dedicated ordinary-player account used only by PB-00.
#        Default:     0 - (Not configured)

Playerbots.Dev.AccountId = 0

#
#    Playerbots.Dev.CharacterGuid
#        Description: Offline Warrior, Mage, or Priest GUID owned by Playerbots.Dev.AccountId.
#        Default:     0 - (Not configured)

Playerbots.Dev.CharacterGuid = 0

#
#    Playerbots.Dev.AccountId2
#        Description: Optional second dedicated ordinary-player account; must differ from AccountId.
#        Default:     0 - (Not configured)

Playerbots.Dev.AccountId2 = 0

#
#    Playerbots.Dev.CharacterGuid2
#        Description: Offline Warrior, Mage, or Priest GUID owned by AccountId2;
#                     must differ from CharacterGuid.
#        Default:     0 - (Not configured)

Playerbots.Dev.CharacterGuid2 = 0

#
#    Playerbots.Dev.AccountId3 / Playerbots.Dev.CharacterGuid3
#    Playerbots.Dev.AccountId4 / Playerbots.Dev.CharacterGuid4
#        Description: Optional third and fourth dedicated ordinary-player bot slots.
#                     Supported classes are Warrior, Mage, and Priest.
#                     Every configured account and character GUID must be distinct.
#        Default:     0 - (Not configured)

Playerbots.Dev.AccountId3 = 0
Playerbots.Dev.CharacterGuid3 = 0
Playerbots.Dev.AccountId4 = 0
Playerbots.Dev.CharacterGuid4 = 0

#
#    Playerbots.Managed.Enabled
#        Description: Permit console-managed admission of existing characters.
#                     No characters are connected automatically at startup.
#                     Listing and stopping configured bots remain available
#                     when admission is disabled.
#        Default:     0 - (Disabled)

Playerbots.Managed.Enabled = 0

#
#    Playerbots.Managed.Characters
#        Description: Comma-separated accountId:characterGuid pairs, for example
#                     101:2001,102:2002. Each account and character must be unique.
#                     Characters must already exist and pass native admission checks.
#                     This identifies managed accounts, not their party controllers.
#        Default:     (empty)

Playerbots.Managed.Characters =
